# ThreadForge runs in a self-contained "demo mode" until these credentials are
# filled in: if NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is missing, the app serves an
# in-memory sample workspace so you can try the UI with no setup at all.
# Set NEXT_PUBLIC_DEMO_MODE=1 to force demo mode even when keys are present.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/threadforge"

# ─── Clerk (Auth) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Used by /api/webhooks/clerk to verify Svix signatures (user.created / updated / deleted)
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard/mockups
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard/mockups

# ─── Cloudinary (Storage + Image Transforms) ─────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=threadforge_uploads

# ─── Stripe (Payments) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_STUDIO_PRICE_ID=price_...

# ─── Resend (Email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@threadforge.io

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Force the zero-config demo workspace (no database / auth required)
# NEXT_PUBLIC_DEMO_MODE=1
